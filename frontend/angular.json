{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": false
  },
  "newProjectRoot": "projects",
  "projects": {
    "dativa-web": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "apps/dativa-web",
      "sourceRoot": "apps/dativa-web/src",
      "prefix": "dtv",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "apps/dativa-web/src/main.ts",
            "tsConfig": "apps/dativa-web/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "apps/dativa-web/public"
              }
            ],
            "styles": [
              "libs/dativa-ui/src/styles/index.scss",
              "apps/dativa-web/src/styles.scss"
            ],
            "allowedCommonJsDependencies": ["@stomp/stompjs", "xlsx"]
          },
          "configurations": {
            "production": {
              "fileReplacements": [
                {
                  "replace": "apps/dativa-web/src/environments/environment.ts",
                  "with": "apps/dativa-web/src/environments/environment.prod.ts"
                }
              ],
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "750kB",
                  "maximumError": "2MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "12kB",
                  "maximumError": "16kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "proxyConfig": "apps/dativa-web/proxy.conf.json"
          },
          "configurations": {
            "production": {
              "buildTarget": "dativa-web:build:production"
            },
            "development": {
              "buildTarget": "dativa-web:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    },
    "dativa-ui": {
      "projectType": "library",
      "root": "libs/dativa-ui",
      "sourceRoot": "libs/dativa-ui/src",
      "prefix": "dtv",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "libs/dativa-ui/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "libs/dativa-ui/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "libs/dativa-ui/tsconfig.spec.json"
          }
        }
      }
    }
  }
}
